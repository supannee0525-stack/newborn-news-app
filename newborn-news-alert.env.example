PORT=5630
HOST=127.0.0.1
ALLOWED_ORIGINS=https://ai4you.click
ALERT_RATE_LIMIT_PER_MINUTE=20

# Optional but recommended. If set, each staff device must store this code before it can send LINE alerts.
NEWS_ALERT_SHARED_SECRET=

# LINE Messaging API credentials. Keep real values only in /etc/newborn-news-alert.env, not in Git.
LINE_CHANNEL_ACCESS_TOKEN=
LINE_CHANNEL_SECRET=
LINE_GROUP_ID=
